ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://elite:elite@localhost:5432/elite
FRONTEND_URL=http://localhost:3000
SEED_PASSWORD=DevOnly123!

# Autenticação e catálogo. Substitua os placeholders e nunca versione valores reais.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TICKETMASTER_API_KEY=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2/
TICKETMASTER_TIMEOUT_SECONDS=10

# Assinatura independente dos tokens QR dos ingressos.
TICKET_SECRET=replace-with-an-independent-long-random-secret
